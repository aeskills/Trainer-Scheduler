rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// TrainerPlan – Firestore Security Rules
//  • Admin (custom claim role == 'admin') can do everything.
//  • Trainers can only read/write their own visits, only while PLANNED and only
//    for today/future dates (IST). Status, photos, reminder flags are server-only.
//  • otpRequests, emailLogs, driveFolders, rateLimits are Cloud Functions only.
//  • Sessions older than 30 days are rejected (forces re-login).
// ─────────────────────────────────────────────────────────────────────────────
service cloud.firestore {
  match /databases/{database}/documents {

    // ── helpers ──────────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }
    // 30 days = 2,592,000 seconds
    function sessionFresh() {
      return signedIn()
        && request.auth.token.auth_time is int
        && request.time.toMillis() < (request.auth.token.auth_time + 2592000) * 1000;
    }
    function isAdmin() {
      return sessionFresh() && request.auth.token.role == 'admin';
    }
    function isTrainer() {
      return sessionFresh()
        && request.auth.token.role == 'trainer'
        && request.auth.token.approved == true;
    }
    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    // Today in IST as an int yyyymmdd (UTC + 5h30m).
    function todayKeyIST() {
      let t = request.time + duration.value(330, 'm');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }
    function validSchools(schools) {
      return schools is list && schools.size() >= 1 && schools.size() <= 10;
    }

    // ── users ────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isAdmin() || (sessionFresh() && isSelf(uid));
      // Trainers may only update their own push tokens / UI preferences.
      allow update: if isAdmin()
        || (sessionFresh() && isSelf(uid)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['fcmTokens', 'theme', 'pushPrompted']));
      allow create, delete: if isAdmin();
    }

    // ── settings ─────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if sessionFresh();
      allow write: if isAdmin();
    }

    // ── visits ───────────────────────────────────────────────────────────────
    match /visits/{visitId} {
      allow read: if isAdmin()
        || (isTrainer() && resource.data.trainerId == request.auth.uid);

      allow create: if isAdmin() || (
        isTrainer()
        && visitId == request.auth.uid + '_' + request.resource.data.date
        && request.resource.data.trainerId == request.auth.uid
        && request.resource.data.status == 'PLANNED'
        && request.resource.data.dateKey is int
        && request.resource.data.dateKey >= todayKeyIST()
        && validSchools(request.resource.data.schools)
        && request.resource.data.keys().hasOnly([
             'trainerId', 'trainerName', 'state', 'date', 'dateKey', 'status',
             'schools', 'adobeGalleryDone', 'createdAt', 'updatedAt'
           ])
      );

      allow update: if isAdmin() || (
        isTrainer()
        && resource.data.trainerId == request.auth.uid
        && resource.data.status == 'PLANNED'
        && resource.data.dateKey >= todayKeyIST()
        && validSchools(request.resource.data.schools)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['schools', 'adobeGalleryDone', 'updatedAt'])
      );

      allow delete: if isAdmin() || (
        isTrainer()
        && resource.data.trainerId == request.auth.uid
        && resource.data.status == 'PLANNED'
        && resource.data.dateKey >= todayKeyIST()
        && resource.data.get('photoCount', 0) == 0
      );
    }

    // ── notifications ────────────────────────────────────────────────────────
    match /notifications/{id} {
      allow read: if isAdmin()
        || (sessionFresh() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        sessionFresh()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow create, delete: if isAdmin();
    }

    // ── logs (read-only for admin; written by Cloud Functions) ───────────────
    match /emailLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /activityLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ── server-only collections ──────────────────────────────────────────────
    match /otpRequests/{id}  { allow read, write: if false; }
    match /driveFolders/{id} { allow read, write: if false; }
    match /rateLimits/{id}   { allow read, write: if false; }
  }
}
