# ─────────────────────────────────────────────────────────────────────────────
# TrainerPlan – Environment Variables Reference
# ─────────────────────────────────────────────────────────────────────────────

# --- WEB (web/.env) ---
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:000000000000
VITE_FIREBASE_VAPID_KEY=your_web_push_vapid_key
VITE_FUNCTIONS_REGION=asia-south1
VITE_USE_EMULATORS=false

# --- CLOUD FUNCTIONS (functions/.env) ---
APP_URL=https://your-project.web.app
SMTP_USER=aeskills2026@gmail.com
SMTP_FROM_NAME=TrainerPlan (No-Reply)
DRIVE_ROOT_FOLDER_ID=your_drive_root_folder_id
DRIVE_AUTH_MODE=oauth
DRIVE_PUBLIC_LINKS=true
GOOGLE_OAUTH_CLIENT_ID=your_oauth_desktop_client_id

# --- FUNCTIONS SECRETS (Set via `firebase functions:secrets:set <NAME>`) ---
# SMTP_APP_PASSWORD=16-char-gmail-app-password
# GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
