# ─── Firebase web config (Project settings → General → Your apps → Web app) ───
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push certificate key pair (Project settings → Cloud Messaging → Web configuration)
VITE_FIREBASE_VAPID_KEY=

# Must match the Functions region
VITE_FUNCTIONS_REGION=asia-south1

# Set to "true" to use the local Firebase Emulator Suite
VITE_USE_EMULATORS=false
