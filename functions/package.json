{
  "name": "trainerplan-functions",
  "private": true,
  "type": "commonjs",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:watch": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "drive:token": "node scripts/get-drive-token.mjs"
  },
  "dependencies": {
    "@googleapis/drive": "^27.0.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.6.0",
    "nodemailer": "^6.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.24",
    "typescript": "~5.6",
    "vitest": "^2.1.9"
  }
}
