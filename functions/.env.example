# ─────────────────────────────────────────────────────────────────────────────
# Cloud Functions non-secret config. Copy to `functions/.env` (deployed) and/or
# `functions/.env.local` (emulator only). Secrets go in Secret Manager:
#   firebase functions:secrets:set SMTP_APP_PASSWORD
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set GOOGLE_OAUTH_REFRESH_TOKEN
# For the emulator, put secrets in `functions/.secret.local` (KEY=value lines).
# ─────────────────────────────────────────────────────────────────────────────

# Public URL of the PWA (used in email "Submit Now" links and push click-through)
APP_URL=https://your-project-id.web.app

# Sender Gmail (needs 2-Step Verification + an App Password)
SMTP_USER=aeskills2026@gmail.com
SMTP_FROM_NAME=TrainerPlan (No-Reply)

# Google Drive – "AE Trainer" folder ID: the part after /folders/ in the share link
DRIVE_ROOT_FOLDER_ID=
# oauth = personal Gmail (aeskills2026@gmail.com) · service_account = Workspace Shared Drive
DRIVE_AUTH_MODE=oauth
# Anyone-with-link can view uploaded photos (needed for in-app thumbnails)
DRIVE_PUBLIC_LINKS=true
# OAuth "Desktop app" client ID from Google Cloud Console
GOOGLE_OAUTH_CLIENT_ID=
